POSTGRES_DB=quiz_app
POSTGRES_USER=quizapp
POSTGRES_PASSWORD=quizapp_dev_password
POSTGRES_PORT=55432

BACKEND_PORT=5051
FRONTEND_PORT=8088

# Set this before production deployment.
APP_SECRET=replace-with-a-long-random-secret
LEADERSHIP_REGISTRATION_CODE=lead-123

# Leave empty to use same-origin /api calls through nginx in the frontend container.
VITE_API_URL=

# Update when the frontend is served from a different origin during development.
CORS_ORIGIN=http://localhost:8088

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
MAX_UPLOAD_SIZE_MB=5
